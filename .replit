entrypoint = "kalkulatorpoltest"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["python3", "kalkulatorpoltest.py"]
deploymentTarget = "cloudrun"

[workflows]
runButton = "wespolzespol"

[[workflows.workflow]]
name = "test"
mode = "sequential"
author = 16609480

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 kalkulatorpoltest.py"

[[workflows.workflow]]
name = "wespolzespol"
mode = "sequential"
author = 16609480

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 wespolzespol.py"
